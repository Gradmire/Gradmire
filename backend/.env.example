PORT=4000
FRONTEND_ORIGIN=http://localhost:8080

# ── Database ────────────────────────────────────────────────────────────────
# Leads fall back to memory without it; accounts and booking require it.
# Local without Docker: `npm run db:local` prints a URL like the one below.
DATABASE_URL=postgres://gradmire:gradmire-local@127.0.0.1:54320/gradmire
# Direct (non-pooled) connection for migrations on Neon.
DATABASE_URL_UNPOOLED=
DATABASE_POOL_MAX=5

# ── Security ────────────────────────────────────────────────────────────────
# Required in production (32+ random characters): signs guest manage links,
# verification links and rate-limit keys. Changing it invalidates old links.
APP_SECRET=
# Bearer token for GET /api/v1/leads (unchanged).
ADMIN_API_TOKEN=
# Bearer token for /api/v1/internal/jobs/run (cron / scheduler).
CRON_SECRET=
# Session cookie. Secure defaults on in production. Use SameSite=None only if the
# site and API are on different sites (see docs/consultation-booking-setup.md).
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAMESITE=Lax
SESSION_TTL_HOURS=168
# Read the client IP from X-Forwarded-For (on by default on Vercel).
TRUST_PROXY=

# ── Links in emails ─────────────────────────────────────────────────────────
SITE_URL=http://localhost:8080
SITE_PAGES_PATH=/pages

# ── Booking policy ──────────────────────────────────────────────────────────
BOOKING_SLOT_STEP_MINUTES=30
BOOKING_CHANGE_CUTOFF_HOURS=24
BOOKING_MAX_RESCHEDULES=2
BOOKING_REMINDER_OFFSETS_MINUTES=1440,60
BOOKING_INLINE_SYNC_TIMEOUT_MS=8000

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Leave EMAIL_PROVIDER empty to record messages as "skipped" (nothing is sent).
# gmail | resend | log (log = development only: prints emails to the server log).
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=Gradmire <consultations@your-verified-domain.example>
EMAIL_REPLY_TO=
# Receives "calendar sync failed" alerts.
ADMIN_ALERT_EMAIL=

# ── Calendar (Google) ───────────────────────────────────────────────────────
# Leave CALENDAR_PROVIDER empty to confirm bookings from the database alone.
CALENDAR_PROVIDER=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The JSON key's private_key, with newlines written as \n.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Workspace user to act as (domain-wide delegation); needed for Meet links/invites.
GOOGLE_CALENDAR_IMPERSONATE=
GOOGLE_CALENDAR_CREATE_MEET=false
GOOGLE_CALENDAR_INVITE_ATTENDEES=false
# Consultant interviews go on the reviewer's calendar, or this one if they have none.
GOOGLE_INTERVIEW_CALENDAR_ID=
INTERVIEW_DURATION_MINUTES=45

# ── Google with a personal account (e.g. @gmail.com) instead of a service account
# Get these with `npm run google-oauth` (see docs/google-workspace-setup.md §1b).
# When set, they are used instead of the service account for Gmail, Drive and Calendar.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ── Gmail (service account with domain-wide delegation, or the OAuth account above)
# Sends system email (EMAIL_PROVIDER=gmail) and staff emails from the dashboard.
# Scopes: https://www.googleapis.com/auth/gmail.send and .../gmail.readonly
GMAIL_SENDER=
# Shared mailbox shown in the CRM inbox (defaults to GMAIL_SENDER).
GMAIL_MAILBOX=

# ── Document storage ────────────────────────────────────────────────────────
# drive | local (local = development only: files in backend/.local-uploads).
STORAGE_PROVIDER=
# A folder in a Shared Drive the service account is a member of (Content manager).
GOOGLE_DRIVE_FOLDER_ID=
# Optional: act as a Workspace user instead of the service account.
GOOGLE_DRIVE_IMPERSONATE=

# ── Follow-up reminders (emailed by the background job) ─────────────────────
FOLLOW_UP_REMINDER_MINUTES=60

# -- Sign in with Google (public OAuth "Web application" client id; no secret needed)
# Comma-separate several ids if you use more than one client.
GOOGLE_CLIENT_ID=

# -- Data retention (off until the owner confirms the periods)
RETENTION_ENABLED=false
RETENTION_CONSULTATION_MONTHS=24
RETENTION_LEAD_MONTHS=24
RETENTION_BATCH_SIZE=200
