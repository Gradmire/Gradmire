{
    "redirects": [
        { "source": "/book-consultation", "destination": "/pages/book-consultation.html", "permanent": false },
        { "source": "/dashboard/consultations", "destination": "/pages/dashboard-consultations.html", "permanent": false },
        { "source": "/admin/consultations", "destination": "/pages/admin-consultations.html", "permanent": false }
    ],
    "rewrites": [
        { "source": "/", "destination": "/pages/index.html" }
    ],
    "headers": [
        {
            "source": "/assets/fonts/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
                { "key": "Access-Control-Allow-Origin", "value": "*" }
            ]
        },
        {
            "source": "/assets/(.*)\\.(css|js)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
            ]
        },
        {
            "source": "/assets/(.*)\\.(jpg|jpeg|png|svg|webp|avif)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
            ]
        }
    ]
}
