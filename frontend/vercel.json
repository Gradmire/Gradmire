{
    "cleanUrls": true,
    "redirects": [
        {
            "source": "/pages",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/pages/:path*",
            "destination": "/:path*",
            "permanent": true
        },
        {
            "source": "/dashboard/consultations",
            "destination": "/dashboard-consultations",
            "permanent": false
        },
        {
            "source": "/admin/consultations",
            "destination": "/admin-consultations",
            "permanent": false
        },
        {
            "source": "/dashboard/profile",
            "destination": "/dashboard-profile",
            "permanent": false
        },
        {
            "source": "/dashboard/applications",
            "destination": "/dashboard#applications",
            "permanent": false
        },
        {
            "source": "/dashboard/notifications",
            "destination": "/dashboard-notifications",
            "permanent": false
        },
        {
            "source": "/dashboard/become-consultant",
            "destination": "/dashboard-become-consultant",
            "permanent": false
        },
        {
            "source": "/dashboard/consultant-application",
            "destination": "/dashboard-become-consultant",
            "permanent": false
        },
        {
            "source": "/dashboard/universities",
            "destination": "/find-courses",
            "permanent": false
        },
        {
            "source": "/consultant/dashboard",
            "destination": "/consultant-dashboard",
            "permanent": false
        },
        {
            "source": "/consultant/students",
            "destination": "/consultant-students",
            "permanent": false
        },
        {
            "source": "/consultant/consultations",
            "destination": "/admin-consultations",
            "permanent": false
        },
        {
            "source": "/consultant/availability",
            "destination": "/admin-consultations",
            "permanent": false
        },
        {
            "source": "/consultant/follow-ups",
            "destination": "/consultant-follow-ups",
            "permanent": false
        },
        {
            "source": "/consultant/leads",
            "destination": "/consultant-leads",
            "permanent": false
        },
        {
            "source": "/admin/users",
            "destination": "/admin-users",
            "permanent": false
        },
        {
            "source": "/admin/leads",
            "destination": "/admin-leads",
            "permanent": false
        },
        {
            "source": "/admin/consultant-applications",
            "destination": "/admin-team",
            "permanent": false
        },
        {
            "source": "/admin/employees",
            "destination": "/admin-team#employees",
            "permanent": false
        },
        {
            "source": "/admin/onboarding",
            "destination": "/admin-team#invitations",
            "permanent": false
        },
        {
            "source": "/admin/approvals",
            "destination": "/admin-approvals",
            "permanent": false
        },
        {
            "source": "/admin/audit-logs",
            "destination": "/admin-audit",
            "permanent": false
        },
        {
            "source": "/register",
            "destination": "/signup",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/gm-api/:path*",
            "destination": "https://gradmire-api.vercel.app/:path*"
        },
        {
            "source": "/",
            "destination": "/pages/index"
        },
        {
            "source": "/:path*",
            "destination": "/pages/:path*"
        }
    ],
    "headers": [
        {
            "source": "/assets/fonts/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                },
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                }
            ]
        },
        {
            "source": "/assets/(.*)\\.(css|js)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, stale-while-revalidate=604800"
                }
            ]
        },
        {
            "source": "/assets/(.*)\\.(jpg|jpeg|png|svg|webp|avif)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=604800, stale-while-revalidate=86400"
                }
            ]
        }
    ]
}
